---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = SITE.title, description = SITE.description, image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {image && <meta property="og:image" content={new URL(image, SITE.url)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/css/glightbox.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/js/glightbox.min.js" defer></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        if (typeof GLightbox !== 'undefined') {
          GLightbox({ selector: '.article-content img, .about-content img', type: 'image', loop: true });
        }
      });
    </script>
  </head>
  <body>
    <div id="sw-update-banner" style="display:none;position:fixed;top:0;left:0;right:0;z-index:10000;background:#348cb2;color:#fff;text-align:center;padding:0.6rem 1rem;font-size:0.9rem;cursor:pointer;">
      New version available — click to refresh
    </div>
    <div id="bg"></div>
    <div id="overlay"></div>
    <div id="wrapper">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <a href="/π/" class="pi-easter-egg" aria-label="π">π</a>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        var updateBanner = document.getElementById('sw-update-banner');
        var swReg = null;
        var checkTimer = null;
        var CHECK_INTERVAL = 10 * 60 * 1000;

        function checkForUpdate() {
          if (!swReg) return;
          swReg.update().catch(function() {});
        }

        function startTimer() {
          stopTimer();
          checkTimer = setInterval(function() {
            if (document.visibilityState === 'visible') {
              checkForUpdate();
            }
          }, CHECK_INTERVAL);
        }

        function stopTimer() {
          if (checkTimer) {
            clearInterval(checkTimer);
            checkTimer = null;
          }
        }

        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').then(function(reg) {
            swReg = reg;
            checkForUpdate();
            startTimer();
          });
        });

        document.addEventListener('visibilitychange', function() {
          if (document.visibilityState === 'visible') {
            checkForUpdate();
            startTimer();
          } else {
            stopTimer();
          }
        });

        navigator.serviceWorker.addEventListener('message', function(e) {
          if (e.data && e.data.type === 'NEW_VERSION') {
            updateBanner.style.display = 'block';
          }
        });

        navigator.serviceWorker.addEventListener('controllerchange', function() {
          window.location.reload();
        });

        updateBanner.addEventListener('click', function() {
          if (swReg && swReg.waiting) {
            swReg.waiting.postMessage({ type: 'SKIP_WAITING' });
          }
        });
      }
    </script>
  </body>
</html>
