---
interface Props {
  title: string;
  subtitle?: string;
  icon?: string;
  align?: 'left' | 'center';
}
const { title, subtitle, icon, align = 'left' } = Astro.props;
const centered = align === 'center';
---

<h1 class:list={{ 'page-header-centered': centered }}>
  {icon && <i class={icon}></i>}
  {title}
</h1>
{subtitle && <p class:list={{ 'page-header-centered': centered }}>{subtitle}</p>}

<style>
  h1 {
    margin-bottom: 0.3rem;
  }

  h1 i {
    margin-right: 0.35em;
    color: var(--accent);
    font-size: 0.85em;
  }

  p {
    margin: 0 0 1.5rem;
    color: var(--text-muted);
  }

  .page-header-centered {
    text-align: center;
  }
</style>