---
---

<div class="mermaid">
  <slot />
</div>

<script is:inline>
  (function () {
    var defined = false;
    function init() {
      if (defined) return;
      defined = true;
      var script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
      script.onload = function () {
        mermaid.initialize({
          startOnLoad: false,
          theme: 'dark',
          themeVariables: {
            primaryColor: '#348cb2',
            primaryTextColor: '#f0f4f8',
            primaryBorderColor: 'rgba(120, 180, 220, 0.5)',
            lineColor: '#7dd3fc',
            secondaryColor: 'rgba(10, 18, 30, 0.8)',
            tertiaryColor: 'rgba(10, 18, 30, 0.6)',
            fontFamily: 'Source Sans Pro, sans-serif',
            background: 'rgba(10, 18, 30, 0.9)',
            mainBkg: 'rgba(10, 18, 30, 0.8)',
            nodeBorder: '#7dd3fc',
            clusterBkg: 'rgba(52, 140, 178, 0.15)',
            clusterBorder: 'rgba(120, 180, 220, 0.3)',
            titleColor: '#f0f4f8',
            edgeLabelBackground: 'rgba(10, 18, 30, 0.8)',
          },
        });
        mermaid.run();
      };
      document.head.appendChild(script);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
