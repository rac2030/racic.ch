---

<div class="search-bar" id="search-bar">
  <svg class="search-bar-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
  <input type="text" class="search-bar-input" id="search-bar-input" placeholder="Search..." autocomplete="off" />
  <div class="search-bar-dropdown" id="search-bar-dropdown"></div>
</div>

<script is:inline src="/search.js"></script>
<script is:inline>
(function() {
  var input = document.getElementById('search-bar-input');
  var dropdown = document.getElementById('search-bar-dropdown');
  var index = null;
  var lastWords = [];

  function loadIndex(callback) {
    if (index) { if (callback) callback(); return; }
    fetch('/search-index.json').then(function(r) { return r.json(); }).then(function(data) {
      index = data;
      if (callback) callback();
    }).catch(function() {});
  }

  function positionDropdown() {
    var rect = input.getBoundingClientRect();
    dropdown.style.top = (rect.bottom + 6) + 'px';
    dropdown.style.left = '50%';
    dropdown.style.transform = 'translateX(-50%)';
  }

  function renderResults(results, words) {
    var sectionIcons = { Blog: 'fa-solid fa-pen-nib', Projects: 'fa-solid fa-microchip', Wiki: 'fa-solid fa-book', Page: 'fa-solid fa-file' };
    var html = '';
    results.forEach(function(r) {
      var item = r.item;
      var icon = sectionIcons[item.section] || 'fa-solid fa-file';
      var excerptHtml = r.excerpt ? '<span class="search-bar-result-excerpt">' + r.excerpt + '</span>' : '';
      html += '<a href="' + item.url + '" class="search-bar-result">' +
        '<span class="search-bar-result-icon"><i class="' + icon + '"></i></span>' +
        '<span class="search-bar-result-text"><span class="search-bar-result-title">' + SearchLib.highlight(item.title, words) + '</span>' +
        '<span class="search-bar-result-desc">' + SearchLib.highlight(item.description, words) + '</span>' +
        excerptHtml + '</span>' +
        '<span class="search-bar-result-section">' + item.section + '</span></a>';
    });
    return html;
  }

  function render(results) {
    positionDropdown();

    if (results.exact.length === 0 && results.fuzzy.length === 0) {
      dropdown.innerHTML = '<div class="search-bar-empty">No results found</div>';
      dropdown.style.display = 'block';
      return;
    }

    var html = '';
    if (results.exact.length > 0) {
      html += renderResults(results.exact.map(function(r) {
        var excerpt = (r.bodyMatch || r.score < 1) ? SearchLib.getExcerpt(r.item.body, lastWords) : '';
        return { item: r.item, excerpt: excerpt };
      }), lastWords);
    }
    if (results.fuzzy.length > 0) {
      var header = results.exact.length > 0 ? 'Similar results' : 'Did you mean?';
      html += '<div class="search-bar-section-header">' + header + '</div>';
      html += renderResults(results.fuzzy.map(function(r) { return { item: r.item, excerpt: '' }; }), lastWords);
    }
    dropdown.innerHTML = html;
    dropdown.style.display = 'block';
  }

  function doSearch(q) {
    if (!q || !index) { dropdown.style.display = 'none'; return; }
    lastWords = q.toLowerCase().split(/\s+/).filter(Boolean);
    var results = SearchLib.search(index, q);
    render(results);
  }

  loadIndex();

  input.addEventListener('focus', function() {
    positionDropdown();
    if (input.value.trim()) doSearch(input.value.trim());
  });

  input.addEventListener('input', function() {
    var q = input.value.trim();
    if (!q) { dropdown.style.display = 'none'; return; }
    loadIndex(function() { doSearch(q); });
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      dropdown.style.display = 'none';
      input.blur();
    }
    if (e.key === 'Enter') {
      var q = input.value.trim();
      if (q) {
        dropdown.style.display = 'none';
        window.location.href = '/search?q=' + encodeURIComponent(q);
      }
    }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      var first = dropdown.querySelector('.search-bar-result');
      if (first) first.focus();
    }
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.search-bar')) dropdown.style.display = 'none';
  });

  dropdown.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      var next = document.activeElement && document.activeElement.nextElementSibling;
      if (next && next.classList.contains('search-bar-result')) next.focus();
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      var prev = document.activeElement && document.activeElement.previousElementSibling;
      if (prev && prev.classList.contains('search-bar-result')) prev.focus();
      else input.focus();
    }
  });
})();
</script>
