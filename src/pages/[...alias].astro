---
import { getCollection, render } from 'astro:content';
import Post from '../layouts/Post.astro';
import Comments from '../components/Comments.astro';
import ContentResizer from '../components/ContentResizer.astro';

const EDIT_BASE: Record<string, string> = {
  blog: 'https://github.com/rac2030/racic.ch/edit/main/src/content/blog',
  projects: 'https://github.com/rac2030/racic.ch/edit/main/src/content/projects',
  wiki: 'https://github.com/rac2030/racic.ch/edit/main/src/content/wiki',
  bookmarks: 'https://github.com/rac2030/racic.ch/edit/main/src/content/bookmarks',
};

export async function getStaticPaths() {
  const collections = ['blog', 'projects', 'wiki', 'bookmarks'] as const;
  const paths = [];

  for (const collectionName of collections) {
    const entries = await getCollection(collectionName);
    for (const entry of entries) {
      if (import.meta.env.MODE === 'production' && entry.data.draft) continue;
      for (const alias of entry.data.aliases || []) {
        if (alias.startsWith('/')) {
          const slugParts = alias.replace(/^\/+|\/+$/g, '');
          paths.push({
            params: { alias: slugParts },
            props: { entry, collectionName },
          });
        }
      }
    }
  }

  return paths;
}

const { entry, collectionName } = Astro.props;
const { Content } = await render(entry);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const editUrl = `${EDIT_BASE[collectionName] || ''}/${entry.id}`;
const tagLinks = entry.data.tags.map((t) => `<a href="/tags/${t}" class="tag">${t}</a>`).join(' ');
---

<Post title={entry.data.title} description={entry.data.description} image={entry.data.heroImage}>
  <article>
    <div class="article-header">
      <a href={editUrl} class="article-edit" target="_blank" rel="noopener noreferrer" title="Edit on GitHub"><i class="fa-solid fa-pen"></i></a>
      <div class="container content-width">
        {entry.data.heroImage && <img src={entry.data.heroImage} alt={entry.data.title} style="margin-bottom: 1.5rem;" />}
        <h1>{entry.data.title}{entry.data.draft && <span class="draft-badge">Draft</span>}</h1>
        <div class="article-meta">
          {entry.data.category && (
            <a href={`/${collectionName}?category=${entry.data.category}`} class="article-category">{entry.data.category}</a>
          )}
          {entry.data.pubDate && (
            <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
          )}
          {entry.data.updatedDate && entry.data.updatedDate.getTime() !== entry.data.pubDate?.getTime() && (
            <span class="article-updated">(updated <time datetime={entry.data.updatedDate.toISOString()}>{formatDate(entry.data.updatedDate)}</time>)</span>
          )}
          <div set:html={tagLinks} />
        </div>
      </div>
    </div>
    <ContentResizer>
      <div class="container article-content">
        <Content />
        <Comments />
      </div>
    </ContentResizer>
  </article>
</Post>
