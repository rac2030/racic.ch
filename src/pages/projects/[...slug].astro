---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import Comments from '../../components/Comments.astro';
import ContentResizer from '../../components/ContentResizer.astro';
import GitHistory from '../../components/GitHistory.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import HeadingAnchors from '../../components/HeadingAnchors.astro';
import { extractHeadings } from '../../lib/utils';
import gitLogJson from '../../data/git-log.json';

const EDIT_BASE = 'https://github.com/rac2030/racic.ch/edit/main/src/content/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => import.meta.env.MODE === 'production' ? !project.data.draft : true)
    .flatMap((project) => {
      const slug = project.id.replace(/\.md$/, '');
      const aliases = (project.data.aliases || [])
        .filter((alias) => !alias.startsWith('/'))
        .map((alias) => ({
          params: { slug: alias },
          props: { project },
        }));
      return [{ params: { slug }, props: { project } }, ...aliases];
    });
}

const { project } = Astro.props;
const { Content } = await render(project);
const tocHeadings = extractHeadings(project.body ?? '');

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const tagLinks = project.data.tags.map((t) => `<a href="/tags/${t}" class="tag">${t}</a>`).join(' ');
const editUrl = `${EDIT_BASE}/${project.id}`;

const slug = project.id.replace(/\.md$/, '');
const gitLog = gitLogJson[`projects/${slug}`] || null;
const lastCommit = gitLog?.lastCommitDate ? new Date(gitLog.lastCommitDate) : null;
const effectiveUpdatedDate = project.data.updatedDate || (lastCommit && lastCommit.getTime() !== project.data.pubDate.getTime() ? lastCommit : null);
---

<Post
  title={project.data.title}
  description={project.data.description}
  image={project.data.heroImage}
>
  <article>
    {project.data.draft && <div class="draft-watermark">DRAFT — not published in production</div>}
    <div class="article-header">
      <a href={editUrl} class="article-edit" target="_blank" rel="noopener noreferrer" title="Edit on GitHub"><i class="fa-solid fa-pen"></i></a>
      <div class="container content-width">
        {project.data.heroImage && <img src={project.data.heroImage} alt={project.data.title} style="margin-bottom: 1.5rem;" />}
        <h1>{project.data.title}{project.data.draft && <span class="draft-badge">Draft</span>}</h1>
        <div class="article-meta">
          {project.data.category && (
            <a href={`/projects?category=${project.data.category}`} class="article-category">{project.data.category}</a>
          )}
          <time datetime={project.data.pubDate.toISOString()}>{formatDate(project.data.pubDate)}</time>
          <span class="article-author">by {project.data.author}</span>
          {effectiveUpdatedDate && (
            <span class="article-updated" id="git-history-trigger" style="cursor:pointer;" title="View change history">(updated <time datetime={effectiveUpdatedDate.toISOString()}>{formatDate(effectiveUpdatedDate)}</time>)</span>
          )}
          <div set:html={tagLinks} />
        </div>
      </div>
    </div>
    <TableOfContents headings={tocHeadings} />
    <ContentResizer>
      <HeadingAnchors />
      <div class="container article-content">
        {project.data.repo && (
          <p><a href={project.data.repo} class="btn" style="margin-bottom: 1.5rem;"><i class="fa-brands fa-github"></i> View Source on GitHub</a></p>
        )}
        <Content />
        <Comments />
      </div>
    </ContentResizer>
    {gitLog && <GitHistory commits={gitLog.commits} />}
  </article>
</Post>
