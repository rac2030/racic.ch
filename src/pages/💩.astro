---
import Base from '../layouts/Base.astro';
---

<Base title="💩">
  <section class="section">
    <div class="container" style="max-width: 800px; text-align: center;">
      <h1 style="font-size: 4rem; margin-bottom: 1rem;">💩</h1>
      <div style="position: relative; width: 100%; padding-bottom: 56.25%; margin: 2rem 0;">
        <iframe
          src="https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1&mute=1&fs=1"
          style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; border-radius: var(--radius-lg);"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Base>
