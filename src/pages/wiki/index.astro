---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getCollection } from 'astro:content';
import { buildWikiGraph } from '../../lib/wiki-graph';

const isProd = import.meta.env.MODE === 'production';
const entries = (await getCollection('wiki'))
  .filter((e) => isProd ? !e.data.draft : true)
  .sort((a, b) => (a.data.title).localeCompare(b.data.title));

const bookmarkEntries = (await getCollection('bookmarks'))
  .filter((e) => isProd ? !e.data.draft : true)
  .sort((a, b) => (a.data.title).localeCompare(b.data.title));

const allTags = [...new Set(entries.flatMap((e) => e.data.tags))].sort();
const allCategories = [...new Set(entries.map((e) => e.data.category).filter(Boolean))].sort();

const wikiGraph = buildWikiGraph(
  entries.map((e) => ({
    slug: e.id.replace(/\.md$/, ''),
    title: e.data.title,
    tags: e.data.tags,
    category: e.data.category || 'uncategorized',
  })),
  bookmarkEntries.map((e) => ({
    slug: e.id.replace(/\.md$/, ''),
    title: e.data.title,
    tags: e.data.tags,
  }))
);

const graphNodes = wikiGraph.nodes;
const graphEdges = wikiGraph.edges;
---

<Base title="Wiki | Michel Racic" description="Technical wiki — quick references, how-tos, and useful notes.">
  <section class="section">
    <div class="container">
      <PageHeader title="Wiki" icon="fa-solid fa-book" subtitle="Quick references, how-tos, and useful technical notes." />

      <div class="wiki-graph-wrap">
        <canvas id="wiki-graph" width="1100" height="500"></canvas>
        <div class="wiki-graph-controls">
          <button id="wg-zoom-in" title="Zoom in">+</button>
          <button id="wg-zoom-out" title="Zoom out">-</button>
          <button id="wg-reset" title="Reset view">Reset</button>
        </div>
        <div class="wiki-graph-tooltip" id="wg-tooltip"></div>
      </div>

      <div class="wiki-filter-row">
        <TagFilter tags={allTags} label="Filter wiki by tag..." />
        <div class="category-filter" id="wiki-category-filter">
          <span class="category-filter-label">Category:</span>
          <div class="category-filter-btns">
            <button class="category-btn active" data-category="all">All</button>
            {allCategories.map((cat) => (
              <button class="category-btn" data-category={cat}>{cat}</button>
            ))}
          </div>
        </div>
      </div>

      <div class="wiki-grid">
        {entries.map((entry) => (
          <a href={`/wiki/${entry.id.replace(/\.md$/, '')}`} class="wiki-card" data-tags={JSON.stringify(entry.data.tags)} data-category={entry.data.category || 'uncategorized'}>
            {entry.data.heroImage && (
              <div class="wiki-card-hero">
                <img src={entry.data.heroImage} alt="" loading="lazy" />
              </div>
            )}
            <h3>{entry.data.title}</h3>
            {entry.data.description && <p>{entry.data.description}</p>}
            <div class="card-tags" style="margin-top: 0.5rem;">
              {entry.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ graphNodes, graphEdges }}>
(function() {
  var canvas = document.getElementById('wiki-graph');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var tooltip = document.getElementById('wg-tooltip');

  var allNodes = graphNodes;
  var allEdges = graphEdges;
  var nodeById = {};
  allNodes.forEach(function(n) { nodeById[n.id] = n; });

  var dpr = window.devicePixelRatio || 1;
  var W, H;
  function resize() {
    var rect = canvas.parentElement.getBoundingClientRect();
    W = rect.width;
    H = 500;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  window.addEventListener('resize', resize);

  var catColors = {
    bookmarks: '#348cb2',
    development: '#7dd3fc',
    library: '#a78bfa',
    security: '#f97316',
    uncategorized: '#6b7280'
  };
  var bookmarkColor = '#348cb2';

  var categories = {};
  allNodes.forEach(function(n) {
    if (n.type !== 'wiki') return;
    if (!categories[n.category]) categories[n.category] = [];
    categories[n.category].push(n);
  });
  var catKeys = Object.keys(categories);
  var cx = W / 2, cy = H / 2;
  var clusterRadius = Math.min(W, H) * 0.3;
  var clusterCenters = {};
  catKeys.forEach(function(cat, i) {
    var angle = (2 * Math.PI * i) / catKeys.length - Math.PI / 2;
    clusterCenters[cat] = {
      x: cx + clusterRadius * Math.cos(angle),
      y: cy + clusterRadius * Math.sin(angle)
    };
  });

  allNodes.forEach(function(n) {
    n.x = 0;
    n.y = 0;
    n.vx = 0;
    n.vy = 0;
    n.radius = 8 + Math.min(n.tags.length * 2, 12);
    n.initialized = false;
  });

  function initNodePosition(n) {
    if (n.initialized) return;
    n.initialized = true;
    if (n.type === 'bookmark') {
      n.x = cx + (Math.random() - 0.5) * 100;
      n.y = cy + (Math.random() - 0.5) * 100;
      return;
    }
    var cc = clusterCenters[n.category] || { x: cx, y: cy };
    var catNodes = categories[n.category] || [n];
    var idx = catNodes.indexOf(n);
    var localAngle = (2 * Math.PI * idx) / Math.max(catNodes.length, 1);
    var localR = 40 + catNodes.length * 5;
    n.x = cc.x + localR * Math.cos(localAngle);
    n.y = cc.y + localR * Math.sin(localAngle);
  }
  allNodes.forEach(initNodePosition);

  var selectedTags = [];
  var selectedCategory = null;
  var validTagSet = {};
  allNodes.forEach(function(n) {
    if (n.type !== 'wiki') return;
    n.tags.forEach(function(t) { validTagSet[t] = true; });
  });
  var params = new URLSearchParams(window.location.search);
  var tagParam = params.get('tags');
  if (tagParam) {
    selectedTags = tagParam.split(',').filter(function(t) { return !!validTagSet[t]; });
  }
  var catParam = params.get('category');
  if (catParam && catParam !== 'all') selectedCategory = catParam;

  function passesTags(n) {
    if (selectedTags.length === 0) return true;
    return selectedTags.every(function(t) { return n.tags.indexOf(t) !== -1; });
  }

  function passesCategory(n) {
    if (!selectedCategory || n.type !== 'wiki') return true;
    return n.category === selectedCategory;
  }

  var visibleNodes = [];
  var visibleEdges = [];

  function updateGraphVisibility() {
    var nodeIdSet = {};
    allNodes.forEach(function(n) {
      if (n.type === 'wiki') {
        if (passesTags(n) && passesCategory(n)) nodeIdSet[n.id] = true;
      }
    });
    allNodes.forEach(function(n) {
      if (n.type !== 'bookmark') return;
      if (!passesTags(n)) return;
      var connected = allEdges.some(function(e) {
        if (e.type !== 'bookmark') return false;
        if (e.source !== n.id && e.target !== n.id) return false;
        var other = e.source === n.id ? e.target : e.source;
        return nodeIdSet[other] === true;
      });
      if (connected) nodeIdSet[n.id] = true;
    });

    visibleNodes = allNodes.filter(function(n) { return nodeIdSet[n.id] === true; });
    visibleNodes.forEach(initNodePosition);

    var edgeIdSet = {};
    visibleNodes.forEach(function(n) { edgeIdSet[n.id] = true; });
    visibleEdges = allEdges.filter(function(e) {
      return edgeIdSet[e.source] === true && edgeIdSet[e.target] === true;
    });

    restartSimulation();
    publishState();
  }

  function publishState() {
    window.__wikiGraph = {
      totalWikiNodes: allNodes.filter(function(n) { return n.type === 'wiki'; }).length,
      totalBookmarkNodes: allNodes.filter(function(n) { return n.type === 'bookmark'; }).length,
      totalNodes: allNodes.length,
      visibleNodes: visibleNodes.length,
      visibleSlugs: visibleNodes.map(function(n) { return n.slug; }).sort(),
      visibleWikiSlugs: visibleNodes.filter(function(n) { return n.type === 'wiki'; }).map(function(n) { return n.slug; }).sort(),
      visibleBookmarkSlugs: visibleNodes.filter(function(n) { return n.type === 'bookmark'; }).map(function(n) { return n.slug; }).sort(),
      selectedTags: selectedTags.slice(),
      selectedCategory: selectedCategory
    };
  }

  var running = true;
  var stopTimer = setTimeout(function() { running = false; }, 5000);
  function restartSimulation() {
    running = true;
    clearTimeout(stopTimer);
    stopTimer = setTimeout(function() { running = false; }, 5000);
  }

  function simulate() {
    if (!running) return;
    var i, j;
    for (i = 0; i < visibleNodes.length; i++) {
      for (j = i + 1; j < visibleNodes.length; j++) {
        var a = visibleNodes[i], b = visibleNodes[j];
        var dx = b.x - a.x, dy = b.y - a.y;
        var dist = Math.sqrt(dx * dx + dy * dy) || 1;
        var force = 1500 / (dist * dist);
        var fx = (dx / dist) * force, fy = (dy / dist) * force;
        a.vx -= fx; a.vy -= fy;
        b.vx += fx; b.vy += fy;
      }
    }
    visibleEdges.forEach(function(e) {
      var a = nodeById[e.source], b = nodeById[e.target];
      if (!a || !b) return;
      var dx = b.x - a.x, dy = b.y - a.y;
      var dist = Math.sqrt(dx * dx + dy * dy) || 1;
      var force = (dist - 80) * 0.015;
      var fx = (dx / dist) * force, fy = (dy / dist) * force;
      a.vx += fx; a.vy += fy;
      b.vx -= fx; b.vy -= fy;
    });
    visibleNodes.forEach(function(n) {
      var cc;
      if (n.type === 'bookmark') {
        cc = { x: cx, y: cy };
      } else {
        cc = clusterCenters[n.category];
      }
      if (cc) {
        n.vx += (cc.x - n.x) * 0.008;
        n.vy += (cc.y - n.y) * 0.008;
      }
      n.vx *= 0.82;
      n.vy *= 0.82;
      n.x += n.vx;
      n.y += n.vy;
    });
  }

  var viewX = 0, viewY = 0, viewScale = 1;
  var dragging = false, dragNode = null, panStartX, panStartY, panViewX, panViewY;

  function screenToWorld(sx, sy) {
    return { x: (sx - viewX) / viewScale, y: (sy - viewY) / viewScale };
  }

  function drawNodeShape(n) {
    ctx.beginPath();
    if (n.type === 'bookmark') {
      ctx.moveTo(n.x, n.y - n.radius);
      ctx.lineTo(n.x + n.radius, n.y);
      ctx.lineTo(n.x, n.y + n.radius);
      ctx.lineTo(n.x - n.radius, n.y);
      ctx.closePath();
    } else {
      ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    ctx.translate(viewX, viewY);
    ctx.scale(viewScale, viewScale);

    var nodeIdSet = {};
    visibleNodes.forEach(function(n) { nodeIdSet[n.id] = true; });

    catKeys.forEach(function(cat) {
      var catNodes = categories[cat].filter(function(n) { return nodeIdSet[n.id]; });
      if (catNodes.length < 1) return;
      var minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
      catNodes.forEach(function(n) {
        minX = Math.min(minX, n.x - n.radius - 20);
        maxX = Math.max(maxX, n.x + n.radius + 20);
        minY = Math.min(minY, n.y - n.radius - 20);
        maxY = Math.max(maxY, n.y + n.radius + 20);
      });
      var color = catColors[cat] || catColors['uncategorized'];
      ctx.beginPath();
      ctx.roundRect(minX, minY, maxX - minX, maxY - minY, 12);
      ctx.fillStyle = color.slice(0, 7) + '10';
      ctx.fill();
      ctx.strokeStyle = color.slice(0, 7) + '30';
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 4]);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = color;
      ctx.font = 'bold 11px Source Sans Pro, sans-serif';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      ctx.fillText(cat, minX + 8, minY + 6);
    });

    visibleEdges.forEach(function(e) {
      var a = nodeById[e.source], b = nodeById[e.target];
      if (!a || !b) return;
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.strokeStyle = e.type === 'tag' ? 'rgba(125,211,252,0.25)' :
        (e.type === 'category' ? 'rgba(167,139,250,0.15)' : 'rgba(52,140,178,0.6)');
      ctx.lineWidth = 1;
      if (e.type === 'bookmark') ctx.setLineDash([6, 3]);
      ctx.stroke();
      ctx.setLineDash([]);
    });

    visibleNodes.forEach(function(n) {
      var color = n.type === 'bookmark' ? bookmarkColor :
        (catColors[n.category] || catColors['uncategorized']);
      drawNodeShape(n);
      ctx.fillStyle = color;
      ctx.globalAlpha = 0.85;
      ctx.fill();
      ctx.globalAlpha = 1;
      ctx.strokeStyle = 'rgba(255,255,255,0.3)';
      ctx.lineWidth = 1;
      ctx.stroke();

      if (viewScale > 0.5) {
        ctx.fillStyle = '#f0f4f8';
        ctx.font = (viewScale > 0.8 ? '12' : '10') + 'px Source Sans Pro, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillText(n.title, n.x, n.y + n.radius + 4);
      }
    });

    ctx.restore();
    requestAnimationFrame(function() { simulate(); draw(); });
  }

  updateGraphVisibility();
  draw();

  canvas.addEventListener('mousedown', function(e) {
    var rect = canvas.getBoundingClientRect();
    var sx = e.clientX - rect.left, sy = e.clientY - rect.top;
    var w = screenToWorld(sx, sy);
    for (var i = visibleNodes.length - 1; i >= 0; i--) {
      var dx = w.x - visibleNodes[i].x, dy = w.y - visibleNodes[i].y;
      if (dx * dx + dy * dy < visibleNodes[i].radius * visibleNodes[i].radius) {
        dragNode = visibleNodes[i];
        return;
      }
    }
    dragging = true;
    panStartX = sx;
    panStartY = sy;
    panViewX = viewX;
    panViewY = viewY;
    canvas.style.cursor = 'grabbing';
  });

  canvas.addEventListener('mousemove', function(e) {
    var rect = canvas.getBoundingClientRect();
    var sx = e.clientX - rect.left, sy = e.clientY - rect.top;

    if (dragNode) {
      var w = screenToWorld(sx, sy);
      dragNode.x = w.x;
      dragNode.y = w.y;
      dragNode.vx = 0;
      dragNode.vy = 0;
      running = false;
      return;
    }

    if (dragging) {
      viewX = panViewX + (sx - panStartX);
      viewY = panViewY + (sy - panStartY);
      return;
    }

    var w = screenToWorld(sx, sy);
    var hovered = null;
    for (var i = visibleNodes.length - 1; i >= 0; i--) {
      var dx = w.x - visibleNodes[i].x, dy = w.y - visibleNodes[i].y;
      if (dx * dx + dy * dy < visibleNodes[i].radius * visibleNodes[i].radius) {
        hovered = visibleNodes[i];
        break;
      }
    }
    if (hovered) {
      canvas.style.cursor = 'pointer';
      tooltip.style.display = 'block';
      tooltip.style.left = (sx + 12) + 'px';
      tooltip.style.top = (sy - 10) + 'px';
      var kind = hovered.type === 'bookmark' ? 'Bookmark' : (hovered.category || 'Wiki');
      tooltip.innerHTML = '<strong>' + hovered.title + '</strong><br>' +
        '<span style="color:var(--accent)">' + kind + '</span>' +
        (hovered.tags.length ? '<br>' + hovered.tags.join(', ') : '');
    } else {
      canvas.style.cursor = dragging ? 'grabbing' : 'grab';
      tooltip.style.display = 'none';
    }
  });

  canvas.addEventListener('mouseup', function() {
    if (dragNode) {
      dragNode = null;
      return;
    }
    dragging = false;
    canvas.style.cursor = 'grab';
  });

  canvas.addEventListener('mouseleave', function() {
    dragging = false;
    dragNode = null;
    canvas.style.cursor = 'grab';
    tooltip.style.display = 'none';
  });

  canvas.addEventListener('wheel', function(e) {
    e.preventDefault();
    var rect = canvas.getBoundingClientRect();
    var sx = e.clientX - rect.left, sy = e.clientY - rect.top;
    var delta = e.deltaY < 0 ? 1.15 : 0.87;
    var newScale = Math.max(0.2, Math.min(5, viewScale * delta));
    var ratio = newScale / viewScale;
    viewX = sx - (sx - viewX) * ratio;
    viewY = sy - (sy - viewY) * ratio;
    viewScale = newScale;
  }, { passive: false });

  canvas.addEventListener('dblclick', function(e) {
    var rect = canvas.getBoundingClientRect();
    var sx = e.clientX - rect.left, sy = e.clientY - rect.top;
    var w = screenToWorld(sx, sy);
    for (var i = visibleNodes.length - 1; i >= 0; i--) {
      var dx = w.x - visibleNodes[i].x, dy = w.y - visibleNodes[i].y;
      if (dx * dx + dy * dy < visibleNodes[i].radius * visibleNodes[i].radius) {
        var n = visibleNodes[i];
        var base = n.type === 'bookmark' ? '/bookmarks/' : '/wiki/';
        window.location.href = base + n.slug + '/';
        return;
      }
    }
  });

  document.getElementById('wg-zoom-in').addEventListener('click', function() {
    viewScale = Math.min(5, viewScale * 1.3);
  });
  document.getElementById('wg-zoom-out').addEventListener('click', function() {
    viewScale = Math.max(0.2, viewScale * 0.7);
  });
  document.getElementById('wg-reset').addEventListener('click', function() {
    viewScale = 1;
    viewX = 0;
    viewY = 0;
  });

  document.addEventListener('tag-filter-change', function(e) {
    if (e.detail && e.detail.tags) selectedTags = e.detail.tags;
    else selectedTags = [];
    updateGraphVisibility();
  });

  document.addEventListener('category-filter-change', function(e) {
    selectedCategory = (e.detail && e.detail.category) || null;
    updateGraphVisibility();
  });

  var catBtns = document.querySelectorAll('.category-btn');
  var initialCat = catParam;

  function filterWikiCards(cat) {
    document.querySelectorAll('.wiki-card').forEach(function(card) {
      if (cat === 'all') { card.style.display = ''; return; }
      var cardCat = card.getAttribute('data-category') || '';
      card.style.display = cardCat === cat ? '' : 'none';
    });
  }

  function notifyCategoryFilter(cat) {
    document.getElementById('wiki-category-filter').dispatchEvent(new CustomEvent('category-filter-change', {
      bubbles: true,
      detail: { category: cat === 'all' ? null : cat }
    }));
  }

  catBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      catBtns.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var cat = btn.getAttribute('data-category');
      filterWikiCards(cat);
      notifyCategoryFilter(cat);
    });
  });

  if (initialCat) {
    catBtns.forEach(function(b) { b.classList.remove('active'); });
    var match = document.querySelector('.category-btn[data-category="' + initialCat + '"]');
    if (match) match.classList.add('active');
    filterWikiCards(initialCat);
  }
})();
</script>