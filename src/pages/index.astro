---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { getCollection } from 'astro:content';
import { effectiveUpdatedDate, formatDate as fmtDate, stripMdExtension } from '../lib/utils';
import gitLogJson from '../data/git-log.json';

const isProd = import.meta.env.MODE === 'production';

const blog = (await getCollection('blog')).filter((p) => isProd ? !p.data.draft : true);
const projects = (await getCollection('projects')).filter((p) => isProd ? !p.data.draft : true);
const wiki = (await getCollection('wiki')).filter((e) => isProd ? !e.data.draft : true);

const lastCommitFor = (section: string, slug: string) =>
  gitLogJson?.[`${section}/${slug}`]?.lastCommitDate;

interface RecentItem {
  title: string;
  description: string;
  url: string;
  section: string;
  date: Date;
}

const items: RecentItem[] = [
  ...blog.map((p) => {
    const slug = stripMdExtension(p.id);
    return {
      title: p.data.title,
      description: p.data.description,
      url: `/blog/${slug}`,
      section: 'Blog',
      date: effectiveUpdatedDate(p.data.pubDate, p.data.updatedDate, lastCommitFor('blog', slug)),
    };
  }),
  ...projects.map((p) => {
    const slug = stripMdExtension(p.id);
    return {
      title: p.data.title,
      description: p.data.description,
      url: `/projects/${slug}`,
      section: 'Projects',
      date: effectiveUpdatedDate(p.data.pubDate, p.data.updatedDate, lastCommitFor('projects', slug)),
    };
  }),
  ...wiki.filter((e) => e.data.pubDate).map((e) => {
    const slug = stripMdExtension(e.id);
    return {
      title: e.data.title,
      description: e.data.description,
      url: `/wiki/${slug}`,
      section: 'Wiki',
      date: effectiveUpdatedDate(e.data.pubDate!, e.data.updatedDate, lastCommitFor('wiki', slug)),
    };
  }),
];

items.sort((a, b) => b.date.valueOf() - a.date.valueOf());
const recent = items.slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="hero-content">
      <h1>{SITE.title}</h1>
      <p class="subtitle">{SITE.description}</p>
      <div class="hero-links">
        <a href="/projects" class="btn btn-primary"><i class="fa-solid fa-microchip"></i> Projects</a>
        <a href="/blog" class="btn"><i class="fa-solid fa-pen-nib"></i> Blog</a>
        <a href="/wiki" class="btn"><i class="fa-solid fa-book"></i> Wiki</a>
        <a href="/about" class="btn"><i class="fa-solid fa-user"></i> About</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 800px;">
      <h2 style="text-align: center; margin-bottom: 1.5rem;">Recently Updated</h2>
      <div class="recent-list">
        {recent.map((item) => (
          <a href={item.url} class="recent-item">
            <span class="recent-item-top">
              <span class="recent-item-section">{item.section}</span>
              <time class="recent-item-date" datetime={item.date.toISOString()}>{fmtDate(item.date)}</time>
            </span>
            <span class="recent-item-text">
              <span class="recent-item-title">{item.title}</span>
              {item.description && <span class="recent-item-desc">{item.description}</span>}
            </span>
          </a>
        ))}
        <a href="/timeline" class="recent-more">More changes →</a>
      </div>
    </div>
  </section>
</Base>
