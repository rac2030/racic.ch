{
  "name": "racic.ch",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-git-log.mjs && node scripts/build-sw.js && node scripts/stamp-sw.js && node scripts/build-search.js && astro build",
    "build:git": "node scripts/generate-git-log.mjs",
    "build:sw": "node scripts/build-sw.js && node scripts/stamp-sw.js",
    "build:search": "node scripts/build-search.js",
    "preview": "astro preview",
    "astro": "astro",
    "new": "node scripts/new-post.mjs",
    "new:blog": "node scripts/new-post.mjs blog",
    "new:project": "node scripts/new-post.mjs project",
    "new:wiki": "node scripts/new-post.mjs wiki",
    "new:bookmark": "node scripts/new-post.mjs bookmark",
    "report": "node scripts/migration-report.mjs",
    "report:screenshots": "node scripts/migration-report.mjs screenshots",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npx jest --config jest.config.cjs",
    "test:coverage": "npx jest --config jest.config.cjs --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.4.2",
    "sharp": "^0.33.5",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2"
  }
}
